# Copy this file to server/.env.local and replace the placeholder values
# See config.js for all supported variables

NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# REQUIRED: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Maximum upload size in bytes (default 10 MB)
MAX_UPLOAD_SIZE=10485760
